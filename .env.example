# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinkuan

# App
APP_URL=http://localhost:3000
SCANNER_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-32-bytes-minimum-random-string
# 32 bytes, base64. Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=

# Demo mode: payments and SMS use built-in stand-ins, fixed OTP 123456
DEMO_MODE=true
# Admin login code for a shared demo (6 digits). Unset = admins use 123456 like everyone else.
DEMO_STAFF_CODE=
# Cron routes (/api/cron/*) need Authorization: Bearer $CRON_SECRET. Vercel Cron sends it.
CRON_SECRET=dev-cron-secret
# Set APP_ENV=production on the live site; it refuses to run with DEMO_MODE=true.
APP_ENV=development
# Shared secret the demo gateway uses to sign its webhooks
PAYMENT_WEBHOOK_SECRET=change-me

# Real integrations (not used while DEMO_MODE=true)
REDIS_URL=redis://localhost:6379
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_BASE_URL=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=
SMS_PROVIDER_API_KEY=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=

# Telegram bot (optional; see README > Telegram bot). Leave empty to run without the bot.
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes back on every webhook call. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the @, for the "Connect Telegram" link in settings
TELEGRAM_BOT_USERNAME=
# F22: JSON file of vetted keyword lists from trust and safety, e.g. {"hate": ["…"], "threat": ["…"]}.
# Merged with the small built-in lists in packages/moderation. Leave empty in development.
MODERATION_TERMS_FILE=
