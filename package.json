{
  "name": "dinkuan",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @dinkuan/web exec playwright test",
    "db:generate": "pnpm --filter @dinkuan/db run generate",
    "db:migrate": "pnpm --filter @dinkuan/db run migrate",
    "db:deploy": "pnpm --filter @dinkuan/db run migrate:deploy",
    "db:seed": "pnpm --filter @dinkuan/db run seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp"]
  }
}
