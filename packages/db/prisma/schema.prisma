// ድንኳን (Dinkuan) — events & tickets schema (PRD section 5).
// Social, gifting, marketplace and promotion models are added in their own milestones.
// All money is integer santim. All times are UTC timestamptz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Lang {
  am
  en
}

enum RoleName {
  buyer
  organiser
  admin
}

enum OrganiserType {
  business
  individual
}

enum OrganiserStatus {
  draft
  submitted
  approved
  rejected
}

enum OrganiserMemberRole {
  manager
  scanner
}

enum EventCategory {
  nightlife
  concert
  festival
  comedy
  arts_culture
  conference
  sports
  community
  holiday
}

enum EventStatus {
  draft
  pending_review
  published
  ended
  cancelled
}

enum RefundPolicy {
  no_refunds
  refund_until
}

enum Visibility {
  public
  hidden
}

enum OrderStatus {
  pending
  paid
  failed
  expired
  refunded
  partially_refunded
  refund_pending
}

enum Gateway {
  telebirr
  chapa
}

enum TicketStatus {
  valid
  checked_in
  transferred
  refunded
  void
}

enum RefundStatus {
  pending
  done
  failed
}

enum LedgerType {
  sale
  fee
  refund
  payout
}

enum PayoutStatus {
  requested
  paid
  rejected
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  phone          String   @unique
  name           String?
  email          String?
  lang           Lang     @default(am)
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles            UserRole[]
  sessions         Session[]
  organisers       Organiser[]
  memberships      OrganiserMember[]
  orders           Order[]
  tickets          Ticket[]         @relation("TicketHolder")
  savedEvents      SavedEvent[]
  consents         Consent[]
  transfersFrom    TicketTransfer[] @relation("TransferFrom")
  transfersTo      TicketTransfer[] @relation("TransferTo")

  @@map("users")
}

model UserRole {
  userId String   @map("user_id") @db.Uuid
  role   RoleName
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("roles")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  phone       String   @id
  codeHash    String   @map("code_hash")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  attempts    Int      @default(0)
  // Send rate limit (F1-AC2: max 3 sends per 15 minutes per number)
  sendCount   Int      @default(1) @map("send_count")
  windowStart DateTime @default(now()) @map("window_start") @db.Timestamptz

  @@map("otp_codes")
}

model Organiser {
  id            String          @id @default(uuid()) @db.Uuid
  ownerUserId   String          @map("owner_user_id") @db.Uuid
  name          String
  tin           String?
  licenceUrl    String?         @map("licence_url")
  type          OrganiserType
  status        OrganiserStatus @default(draft)
  payoutMethod  String?         @map("payout_method")
  payoutAccount String?         @map("payout_account")
  payoutHold    Boolean         @default(true) @map("payout_hold")
  trusted       Boolean         @default(false)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  owner   User              @relation(fields: [ownerUserId], references: [id])
  members OrganiserMember[]
  events  Event[]
  ledger  LedgerEntry[]
  payouts Payout[]

  @@map("organisers")
}

model OrganiserMember {
  organiserId String              @map("organiser_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        OrganiserMemberRole
  organiser   Organiser           @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organiserId, userId])
  @@map("organiser_members")
}

model Venue {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  address String
  lat     Float
  lng     Float
  events  Event[]

  @@map("venues")
}

model Event {
  id               String        @id @default(uuid()) @db.Uuid
  organiserId      String        @map("organiser_id") @db.Uuid
  slug             String        @unique
  titleAm          String?       @map("title_am")
  titleEn          String?       @map("title_en")
  descAm           String?       @map("desc_am")
  descEn           String?       @map("desc_en")
  category         EventCategory
  posterUrl        String        @map("poster_url")
  venueId          String        @map("venue_id") @db.Uuid
  startsAt         DateTime      @map("starts_at") @db.Timestamptz
  endsAt           DateTime?     @map("ends_at") @db.Timestamptz
  lineup           String[]
  status           EventStatus   @default(draft)
  refundPolicy     RefundPolicy  @default(no_refunds) @map("refund_policy")
  refundUntil      DateTime?     @map("refund_until") @db.Timestamptz
  feePctBps        Int           @default(500) @map("fee_pct_bps")
  feeFixedSantim   Int           @default(1000) @map("fee_fixed_santim")
  featured         Boolean       @default(false)
  signingPublicKey String?       @map("signing_public_key")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organiser   Organiser        @relation(fields: [organiserId], references: [id])
  venue       Venue            @relation(fields: [venueId], references: [id])
  signingKey  EventSigningKey?
  ticketTypes TicketType[]
  orders      Order[]
  tickets     Ticket[]
  savedBy     SavedEvent[]

  @@index([status, startsAt])
  @@map("events")
}

/// Server-only. The private key is encrypted with KEY_ENCRYPTION_SECRET and never sent to a client.
model EventSigningKey {
  eventId             String @id @map("event_id") @db.Uuid
  privateKeyEncrypted String @map("private_key_encrypted")
  event               Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_signing_keys")
}

model TicketType {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  name        String
  priceSantim Int        @map("price_santim")
  capacity    Int
  sold        Int        @default(0)
  reserved    Int        @default(0)
  perOrderMax Int        @default(10) @map("per_order_max")
  salesStart  DateTime?  @map("sales_start") @db.Timestamptz
  salesEnd    DateTime?  @map("sales_end") @db.Timestamptz
  visibility  Visibility @default(public)
  accessCode  String?    @map("access_code")
  sortOrder   Int        @default(0) @map("sort_order")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@map("ticket_types")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  number         Int         @unique @default(autoincrement())
  userId         String      @map("user_id") @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  status         OrderStatus @default(pending)
  subtotalSantim Int         @map("subtotal_santim")
  feeSantim      Int         @map("fee_santim")
  totalSantim    Int         @map("total_santim")
  gateway        Gateway
  gatewayRef     String      @unique @map("gateway_ref")
  // True while this order still holds reserved inventory (cleared when paid or released).
  holdsReservation Boolean   @default(true) @map("holds_reservation")
  promoCodeId    String?     @map("promo_code_id") @db.Uuid
  promoterLinkId String?     @map("promoter_link_id") @db.Uuid
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user    User          @relation(fields: [userId], references: [id])
  event   Event         @relation(fields: [eventId], references: [id])
  items   OrderItem[]
  tickets Ticket[]
  refunds Refund[]
  ledger  LedgerEntry[]

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id              String     @id @default(uuid()) @db.Uuid
  orderId         String     @map("order_id") @db.Uuid
  ticketTypeId    String     @map("ticket_type_id") @db.Uuid
  qty             Int
  unitPriceSantim Int        @map("unit_price_santim")
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType      TicketType @relation(fields: [ticketTypeId], references: [id])

  @@map("order_items")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  ticketTypeId  String       @map("ticket_type_id") @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  holderUserId  String       @map("holder_user_id") @db.Uuid
  holderName    String       @map("holder_name")
  version       Int          @default(1)
  status        TicketStatus @default(valid)
  transferCount Int          @default(0) @map("transfer_count")
  checkedInAt   DateTime?    @map("checked_in_at") @db.Timestamptz
  checkedInBy   String?      @map("checked_in_by") @db.Uuid
  gate          String?

  order      Order            @relation(fields: [orderId], references: [id])
  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  event      Event            @relation(fields: [eventId], references: [id])
  holder     User             @relation("TicketHolder", fields: [holderUserId], references: [id])
  transfers  TicketTransfer[]
  checkIns   CheckIn[]

  @@index([eventId])
  @@index([holderUserId])
  @@map("tickets")
}

model TicketTransfer {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  fromUser   User     @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUser     User     @relation("TransferTo", fields: [toUserId], references: [id])

  @@map("ticket_transfers")
}

/// Webhook inbox. The unique constraint makes duplicate deliveries a no-op (F5-AC7).
model PaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  gateway     Gateway
  gatewayRef  String   @map("gateway_ref")
  type        String
  rawPayload  Json     @map("raw_payload")
  signatureOk Boolean  @map("signature_ok")
  processed   Boolean  @default(false)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([gateway, gatewayRef, type])
  @@map("payment_events")
}

model Refund {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  amountSantim Int          @map("amount_santim")
  reason       String
  status       RefundStatus @default(pending)
  gatewayRef   String?      @map("gateway_ref")
  createdBy    String?      @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  order        Order        @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

/// Append-only. The app role must not have UPDATE or DELETE on this table (see migration).
model LedgerEntry {
  id                 String     @id @default(uuid()) @db.Uuid
  organiserId        String?    @map("organiser_id") @db.Uuid
  orderId            String?    @map("order_id") @db.Uuid
  type               LedgerType
  amountSantim       Int        @map("amount_santim")
  balanceAfterSantim Int        @map("balance_after_santim")
  ref                String
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  organiser          Organiser? @relation(fields: [organiserId], references: [id])
  order              Order?     @relation(fields: [orderId], references: [id])

  @@index([organiserId, createdAt])
  @@map("ledger_entries")
}

model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  organiserId  String       @map("organiser_id") @db.Uuid
  amountSantim Int          @map("amount_santim")
  status       PayoutStatus @default(requested)
  reference    String?
  paidAt       DateTime?    @map("paid_at") @db.Timestamptz
  organiser    Organiser    @relation(fields: [organiserId], references: [id])

  @@map("payouts")
}

model CheckIn {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @map("ticket_id") @db.Uuid
  scannerUserId String   @map("scanner_user_id") @db.Uuid
  gate          String
  scannedAt     DateTime @map("scanned_at") @db.Timestamptz
  syncedAt      DateTime @default(now()) @map("synced_at") @db.Timestamptz
  /// admitted | duplicate | conflict
  result        String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("check_ins")
}

model Consent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  granted   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_logs")
}

model SavedEvent {
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("saved_events")
}

/// Demo only: the state of the built-in stand-in payment gateway (replaced by Telebirr/Chapa).
model DemoPayment {
  ref          String   @id
  gateway      Gateway
  amountSantim Int      @map("amount_santim")
  description  String
  status       String   @default("pending")
  refundedSantim Int    @default(0) @map("refunded_santim")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("demo_payments")
}
