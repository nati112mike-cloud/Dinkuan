// ድንኳን (Dinkuan) — events & tickets schema (PRD section 5).
// Social, gifting, marketplace and promotion models are added in their own milestones.
// All money is integer santim. All times are UTC timestamptz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Lang {
  am
  en
}

enum RoleName {
  buyer
  organiser
  admin
}

enum OrganiserType {
  business
  individual
}

enum OrganiserStatus {
  draft
  submitted
  approved
  rejected
}

enum OrganiserMemberRole {
  manager
  scanner
}

enum EventCategory {
  nightlife
  concert
  festival
  comedy
  arts_culture
  conference
  sports
  community
  holiday
}

enum EventStatus {
  draft
  pending_review
  published
  ended
  cancelled
}

enum RefundPolicy {
  no_refunds
  refund_until
}

enum Visibility {
  public
  hidden
}

enum OrderStatus {
  pending
  paid
  failed
  expired
  refunded
  partially_refunded
  refund_pending
}

enum Gateway {
  telebirr
  chapa
}

enum TicketStatus {
  valid
  checked_in
  transferred
  refunded
  void
}

enum RefundStatus {
  pending
  done
  failed
}

enum LedgerType {
  sale
  fee
  refund
  payout
  promotion
  promotion_refund
}

enum PayoutStatus {
  requested
  paid
  rejected
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String    @unique
  name           String?
  email          String?
  lang           Lang      @default(am)
  telegramChatId String?   @unique @map("telegram_chat_id")
  /// F22-AC5: set by a suspension. Posting, commenting, messaging and following are blocked until then.
  suspendedUntil DateTime? @map("suspended_until") @db.Timestamptz
  /// F22-AC5: a ban ends every session and blocks login.
  bannedAt       DateTime? @map("banned_at") @db.Timestamptz
  /// PDPP: set when the member deletes their account. The row stays, anonymised, so orders,
  /// tickets and the ledger still add up.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  roles          UserRole[]
  sessions       Session[]
  outbound       OutboundMessage[]
  telegramLogins TelegramLoginToken[]
  organisers     Organiser[]
  memberships    OrganiserMember[]
  orders         Order[]
  tickets        Ticket[]             @relation("TicketHolder")
  savedEvents    SavedEvent[]
  consents       Consent[]
  transfersFrom  TicketTransfer[]     @relation("TransferFrom")
  transfersTo    TicketTransfer[]     @relation("TransferTo")

  profile           Profile?
  following         Follow[]       @relation("Follower")
  followers         Follow[]       @relation("Followee")
  blocksMade        Block[]        @relation("Blocker")
  blocksReceived    Block[]        @relation("Blocked")
  mutesMade         Mute[]         @relation("Muter")
  mutesReceived     Mute[]         @relation("Muted")
  posts             Post[]
  mentions          Mention[]
  reactions         Reaction[]
  comments          Comment[]
  commentLikes      CommentLike[]
  shares            Share[]
  savedPosts        SavedPost[]
  interests         UserInterest[]
  uploads           MediaBlob[]
  reports           Report[]
  notifications     Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")

  vendorProfile   VendorProfile?
  bookingRequests BookingRequest[] @relation("BookingClient")
  messagesSent    Message[]
  shortlists      Shortlist[]
  reviewsWritten  Review[]         @relation("ReviewAuthor")
  campaigns       Campaign[]

  moderationActions ModerationAction[] @relation("ModerationSubject")
  moderationsMade   ModerationAction[] @relation("Moderator")
  strikes           Strike[]
  appeals           Appeal[]           @relation("AppealAuthor")
  appealsReviewed   Appeal[]           @relation("AppealReviewer")

  @@map("users")
}

model UserRole {
  userId String   @map("user_id") @db.Uuid
  role   RoleName
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("roles")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  phone       String   @id
  codeHash    String   @map("code_hash")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  attempts    Int      @default(0)
  // Send rate limit (F1-AC2: max 3 sends per 15 minutes per number)
  sendCount   Int      @default(1) @map("send_count")
  windowStart DateTime @default(now()) @map("window_start") @db.Timestamptz

  @@map("otp_codes")
}

model Organiser {
  id            String          @id @default(uuid()) @db.Uuid
  ownerUserId   String          @map("owner_user_id") @db.Uuid
  name          String
  tin           String?
  licenceUrl    String?         @map("licence_url")
  type          OrganiserType
  status        OrganiserStatus @default(draft)
  payoutMethod  String?         @map("payout_method")
  payoutAccount String?         @map("payout_account")
  payoutHold    Boolean         @default(true) @map("payout_hold")
  trusted       Boolean         @default(false)
  /// F2: shown to the applicant when an admin rejects the application.
  rejectReason  String?         @map("reject_reason")
  submittedAt   DateTime?       @map("submitted_at") @db.Timestamptz
  reviewedAt    DateTime?       @map("reviewed_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  owner   User              @relation(fields: [ownerUserId], references: [id])
  members OrganiserMember[]
  events  Event[]
  ledger  LedgerEntry[]
  payouts Payout[]

  @@map("organisers")
}

model OrganiserMember {
  organiserId String              @map("organiser_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        OrganiserMemberRole
  organiser   Organiser           @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organiserId, userId])
  @@map("organiser_members")
}

model Venue {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  address String
  lat     Float
  lng     Float
  events  Event[]
  posts   Post[]

  @@map("venues")
}

model Event {
  id               String        @id @default(uuid()) @db.Uuid
  organiserId      String        @map("organiser_id") @db.Uuid
  slug             String        @unique
  titleAm          String?       @map("title_am")
  titleEn          String?       @map("title_en")
  descAm           String?       @map("desc_am")
  descEn           String?       @map("desc_en")
  category         EventCategory
  posterUrl        String        @map("poster_url")
  venueId          String        @map("venue_id") @db.Uuid
  startsAt         DateTime      @map("starts_at") @db.Timestamptz
  endsAt           DateTime?     @map("ends_at") @db.Timestamptz
  lineup           String[]
  status           EventStatus   @default(draft)
  refundPolicy     RefundPolicy  @default(no_refunds) @map("refund_policy")
  refundUntil      DateTime?     @map("refund_until") @db.Timestamptz
  feePctBps        Int           @default(500) @map("fee_pct_bps")
  feeFixedSantim   Int           @default(1000) @map("fee_fixed_santim")
  featured         Boolean       @default(false)
  /// F3-AC5: admin note when an event in review is sent back to draft.
  reviewNote       String?       @map("review_note")
  signingPublicKey String?       @map("signing_public_key")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organiser   Organiser        @relation(fields: [organiserId], references: [id])
  venue       Venue            @relation(fields: [venueId], references: [id])
  signingKey  EventSigningKey?
  ticketTypes TicketType[]
  orders      Order[]
  tickets     Ticket[]
  savedBy     SavedEvent[]
  posts       Post[]
  albums      PortfolioAlbum[]
  credits     StageCredit[]

  @@index([status, startsAt])
  @@map("events")
}

/// Server-only. The private key is encrypted with KEY_ENCRYPTION_SECRET and never sent to a client.
model EventSigningKey {
  eventId             String @id @map("event_id") @db.Uuid
  privateKeyEncrypted String @map("private_key_encrypted")
  event               Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_signing_keys")
}

model TicketType {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  name        String
  priceSantim Int        @map("price_santim")
  capacity    Int
  sold        Int        @default(0)
  reserved    Int        @default(0)
  perOrderMax Int        @default(10) @map("per_order_max")
  salesStart  DateTime?  @map("sales_start") @db.Timestamptz
  salesEnd    DateTime?  @map("sales_end") @db.Timestamptz
  visibility  Visibility @default(public)
  accessCode  String?    @map("access_code")
  sortOrder   Int        @default(0) @map("sort_order")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@map("ticket_types")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  number           Int         @unique @default(autoincrement())
  userId           String      @map("user_id") @db.Uuid
  eventId          String      @map("event_id") @db.Uuid
  status           OrderStatus @default(pending)
  subtotalSantim   Int         @map("subtotal_santim")
  feeSantim        Int         @map("fee_santim")
  totalSantim      Int         @map("total_santim")
  gateway          Gateway
  gatewayRef       String      @unique @map("gateway_ref")
  // True while this order still holds reserved inventory (cleared when paid or released).
  holdsReservation Boolean     @default(true) @map("holds_reservation")
  promoCodeId      String?     @map("promo_code_id") @db.Uuid
  promoterLinkId   String?     @map("promoter_link_id") @db.Uuid
  /// F21-AC7: the promotion the buyer clicked before buying, if any.
  campaignId       String?     @map("campaign_id") @db.Uuid
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz
  paidAt           DateTime?   @map("paid_at") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user    User          @relation(fields: [userId], references: [id])
  event   Event         @relation(fields: [eventId], references: [id])
  items   OrderItem[]
  tickets Ticket[]
  refunds Refund[]
  ledger  LedgerEntry[]

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id              String     @id @default(uuid()) @db.Uuid
  orderId         String     @map("order_id") @db.Uuid
  ticketTypeId    String     @map("ticket_type_id") @db.Uuid
  qty             Int
  unitPriceSantim Int        @map("unit_price_santim")
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType      TicketType @relation(fields: [ticketTypeId], references: [id])

  @@map("order_items")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  ticketTypeId  String       @map("ticket_type_id") @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  holderUserId  String       @map("holder_user_id") @db.Uuid
  holderName    String       @map("holder_name")
  version       Int          @default(1)
  status        TicketStatus @default(valid)
  transferCount Int          @default(0) @map("transfer_count")
  checkedInAt   DateTime?    @map("checked_in_at") @db.Timestamptz
  checkedInBy   String?      @map("checked_in_by") @db.Uuid
  gate          String?

  order      Order            @relation(fields: [orderId], references: [id])
  ticketType TicketType       @relation(fields: [ticketTypeId], references: [id])
  event      Event            @relation(fields: [eventId], references: [id])
  holder     User             @relation("TicketHolder", fields: [holderUserId], references: [id])
  transfers  TicketTransfer[]
  checkIns   CheckIn[]

  @@index([eventId])
  @@index([holderUserId])
  @@map("tickets")
}

model TicketTransfer {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  fromUser   User     @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUser     User     @relation("TransferTo", fields: [toUserId], references: [id])

  @@map("ticket_transfers")
}

/// Webhook inbox. The unique constraint makes duplicate deliveries a no-op (F5-AC7).
model PaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  gateway     Gateway
  gatewayRef  String   @map("gateway_ref")
  type        String
  rawPayload  Json     @map("raw_payload")
  signatureOk Boolean  @map("signature_ok")
  processed   Boolean  @default(false)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([gateway, gatewayRef, type])
  @@map("payment_events")
}

model Refund {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  amountSantim Int          @map("amount_santim")
  reason       String
  status       RefundStatus @default(pending)
  gatewayRef   String?      @map("gateway_ref")
  createdBy    String?      @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  order        Order        @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

/// Append-only. The app role must not have UPDATE or DELETE on this table (see migration).
model LedgerEntry {
  id                 String     @id @default(uuid()) @db.Uuid
  organiserId        String?    @map("organiser_id") @db.Uuid
  orderId            String?    @map("order_id") @db.Uuid
  campaignId         String?    @map("campaign_id") @db.Uuid
  type               LedgerType
  amountSantim       Int        @map("amount_santim")
  balanceAfterSantim Int        @map("balance_after_santim")
  ref                String
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  organiser          Organiser? @relation(fields: [organiserId], references: [id])
  order              Order?     @relation(fields: [orderId], references: [id])
  campaign           Campaign?  @relation(fields: [campaignId], references: [id])

  @@index([organiserId, createdAt])
  @@map("ledger_entries")
}

model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  organiserId  String       @map("organiser_id") @db.Uuid
  amountSantim Int          @map("amount_santim")
  status       PayoutStatus @default(requested)
  reference    String?
  paidAt       DateTime?    @map("paid_at") @db.Timestamptz
  organiser    Organiser    @relation(fields: [organiserId], references: [id])

  @@map("payouts")
}

model CheckIn {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @map("ticket_id") @db.Uuid
  scannerUserId String   @map("scanner_user_id") @db.Uuid
  gate          String
  scannedAt     DateTime @map("scanned_at") @db.Timestamptz
  syncedAt      DateTime @default(now()) @map("synced_at") @db.Timestamptz
  /// admitted | duplicate | conflict
  result        String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("check_ins")
}

model Consent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  granted   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_logs")
}

model SavedEvent {
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("saved_events")
}

/// Demo only: the state of the built-in stand-in payment gateway (replaced by Telebirr/Chapa).
model DemoPayment {
  ref            String   @id
  gateway        Gateway
  amountSantim   Int      @map("amount_santim")
  description    String
  status         String   @default("pending")
  refundedSantim Int      @default(0) @map("refunded_santim")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("demo_payments")
}

// ---------------------------------------------------------------------------
// SOCIAL (F14–F17). Counters are denormalised (CLAUDE.md rule 18).

enum FollowStatus {
  active
  requested
}

enum PostType {
  text
  photo
  video
  meme
  reel
}

enum PostAudience {
  public
  followers
}

/// CLAUDE.md rule 14: processing → screening → public | restricted | removed
enum ContentStatus {
  processing
  screening
  public
  restricted
  removed
}

enum MediaKind {
  image
  video
}

enum ReactionType {
  like
  love
  haha
  fire
  wow
  sad
  clap
}

enum CommentStatus {
  visible
  hidden
  removed
}

enum ShareType {
  repost
  external
  dm
}

enum NotificationType {
  follow
  follow_request
  follow_accepted
  reaction
  comment
  reply
  mention
  booking_request
  message
  gig_tag
  gig_verified
  campaign_live
  campaign_rejected
  organiser_approved
  organiser_rejected
  event_approved
  event_rejected
  team_added
  mod_removed
  mod_age_restricted
  mod_warned
  mod_suspended
  mod_banned
  mod_takedown
  appeal_upheld
  appeal_overturned
}

model Profile {
  userId         String   @id @map("user_id") @db.Uuid
  /// Stored lowercase; Latin letters, numbers, `_` and `.` (F14-AC1).
  username       String   @unique
  displayName    String   @map("display_name")
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  coverUrl       String?  @map("cover_url")
  link           String?
  subCity        String?  @map("sub_city")
  isPrivate      Boolean  @default(false) @map("is_private")
  isVerified     Boolean  @default(false) @map("is_verified")
  creatorMode    Boolean  @default(false) @map("creator_mode")
  lowDataMode    Boolean  @default(false) @map("low_data_mode")
  showEvents     Boolean  @default(true) @map("show_events")
  /// Comments containing any of these words are hidden on this person's posts (F16-AC3).
  hiddenWords    String[] @map("hidden_words")
  referralCode   String   @unique @map("referral_code")
  referredById   String?  @map("referred_by_id") @db.Uuid
  onboarded      Boolean  @default(false)
  followersCount Int      @default(0) @map("followers_count")
  followingCount Int      @default(0) @map("following_count")
  postsCount     Int      @default(0) @map("posts_count")
  likesReceived  Int      @default(0) @map("likes_received")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([followersCount])
  @@map("profiles")
}

model Follow {
  followerId String       @map("follower_id") @db.Uuid
  followeeId String       @map("followee_id") @db.Uuid
  status     FollowStatus @default(active)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  follower   User         @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User         @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, status])
  @@map("follows")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Mute {
  muterId   String   @map("muter_id") @db.Uuid
  mutedId   String   @map("muted_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  muter     User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@map("mutes")
}

model Post {
  id            String        @id @default(uuid()) @db.Uuid
  authorId      String        @map("author_id") @db.Uuid
  type          PostType
  caption       String        @default("")
  audience      PostAudience  @default(public)
  eventId       String?       @map("event_id") @db.Uuid
  venueId       String?       @map("venue_id") @db.Uuid
  status        ContentStatus @default(processing)
  /// F22-AC4: age-restricted posts are shown only to signed-in members and never in For You.
  ageRestricted Boolean       @default(false) @map("age_restricted")
  viewCount     Int           @default(0) @map("view_count")
  reactionCount Int           @default(0) @map("reaction_count")
  commentCount  Int           @default(0) @map("comment_count")
  shareCount    Int           @default(0) @map("share_count")
  completions   Int           @default(0)
  /// For You rank key: ln(engagement × boosts) + age decay folded into created time, so it never needs a time-based recompute.
  rankKey       Float         @default(0) @map("rank_key")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  editedAt      DateTime?     @map("edited_at") @db.Timestamptz

  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event     Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venue     Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  media     Media[]
  hashtags  PostHashtag[]
  mentions  Mention[]
  reactions Reaction[]
  comments  Comment[]
  shares    Share[]
  savedBy   SavedPost[]
  watches   WatchEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, rankKey(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([eventId, createdAt(sort: Desc)])
  @@map("posts")
}

model Media {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  kind      MediaKind
  url       String
  /// 240p rendition for low-data mode (F16-AC8), when one exists.
  lowUrl    String?   @map("low_url")
  thumbUrl  String?   @map("thumb_url")
  width     Int
  height    Int
  durationS Int?      @map("duration_s")
  orderIdx  Int       @default(0) @map("order_idx")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  /// The media route looks up which post a blob belongs to before serving it (F22 / rule 14).
  @@index([url])
  @@index([thumbUrl])
  @@map("media")
}

/// Demo storage: uploaded bytes live in Postgres so the demo runs on free hosting.
/// Swap for object storage (STORAGE_BUCKET) before launch.
model MediaBlob {
  id          String   @id @default(uuid()) @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  contentType String   @map("content_type")
  size        Int
  received    Int      @default(0)
  bytes       Bytes    @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@map("media_blobs")
}

model Hashtag {
  id    String        @id @default(uuid()) @db.Uuid
  tag   String        @unique
  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  postId    String  @map("post_id") @db.Uuid
  hashtagId String  @map("hashtag_id") @db.Uuid
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
}

model Mention {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("mentions")
}

model Reaction {
  userId    String       @map("user_id") @db.Uuid
  postId    String       @map("post_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("reactions")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  body      String
  likeCount Int           @default(0) @map("like_count")
  pinned    Boolean       @default(false)
  status    CommentStatus @default(visible)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("Replies")
  likes     CommentLike[]

  @@index([postId, createdAt])
  @@map("comments")
}

model CommentLike {
  userId    String  @map("user_id") @db.Uuid
  commentId String  @map("comment_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@map("comment_likes")
}

model Share {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      ShareType
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("shares")
}

model SavedPost {
  userId     String   @map("user_id") @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  collection String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("saved_posts")
}

model WatchEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  watchedMs Int      @map("watched_ms")
  completed Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("watch_events")
}

model Interest {
  id    String         @id @default(uuid()) @db.Uuid
  key   String         @unique
  users UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
  @@map("user_interests")
}

/// F22-AC3: report button on posts, comments and profiles.
/// F22-AC3/AC4. A null reporter means automated screening flagged the content.
model Report {
  id         String            @id @default(uuid()) @db.Uuid
  reporterId String?           @map("reporter_id") @db.Uuid
  targetType String            @map("target_type")
  targetId   String            @map("target_id")
  /// Author of the reported content, so the queue can show strikes and act on the account.
  subjectId  String?           @map("subject_id") @db.Uuid
  reason     String
  /// 1 low · 2 medium · 3 high · 4 urgent (F22-AC7).
  severity   Int               @default(1)
  details    String?
  status     String            @default("open")
  actionId   String?           @map("action_id") @db.Uuid
  resolvedAt DateTime?         @map("resolved_at") @db.Timestamptz
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  reporter   User?             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  action     ModerationAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

enum ModAction {
  remove
  age_restrict
  warn
  suspend
  ban
  dismiss
}

enum AppealStatus {
  open
  upheld
  overturned
}

/// F22-AC4: every moderator decision. Also audit-logged.
model ModerationAction {
  id           String    @id @default(uuid()) @db.Uuid
  moderatorId  String    @map("moderator_id") @db.Uuid
  targetType   String    @map("target_type")
  targetId     String    @map("target_id")
  subjectId    String?   @map("subject_id") @db.Uuid
  action       ModAction
  reason       String
  note         String?
  /// Content state before the action, so an overturned appeal can restore it.
  before       Json?
  overturnedAt DateTime? @map("overturned_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  moderator    User      @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Cascade)
  subject      User?     @relation("ModerationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reports      Report[]
  strike       Strike?
  appeal       Appeal?

  @@index([subjectId, createdAt(sort: Desc)])
  @@map("moderation_actions")
}

/// F22-AC5: three live strikes in 90 days suspend the account for 7 days.
model Strike {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  actionId  String           @unique @map("action_id") @db.Uuid
  severe    Boolean          @default(false)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("strikes")
}

/// F22-AC6: one appeal per action, decided by a different moderator.
model Appeal {
  id         String           @id @default(uuid()) @db.Uuid
  actionId   String           @unique @map("action_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  text       String
  status     AppealStatus     @default(open)
  reviewerId String?          @map("reviewer_id") @db.Uuid
  decidedAt  DateTime?        @map("decided_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  action     ModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user       User             @relation("AppealAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?            @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("appeals")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  type        NotificationType
  postId      String?          @map("post_id") @db.Uuid
  /// Link target for non-post notifications (a conversation, album or campaign).
  href        String?
  readAt      DateTime?        @map("read_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// MARKETPLACE (F20, Phase 1: pro profiles, portfolio, packages, availability, search,
// compare, shortlists, booking requests and chat). Deposits, offers and bookings are Phase 2.

enum VendorType {
  dj
  photographer
  videographer
  planner
  mc
  decor
  sound_lighting
  makeup
  band
}

enum VendorLevel {
  new
  rising
  top_rated
  pro
}

enum GigStatus {
  none
  pending
  verified
  declined
}

enum PackageTier {
  basic
  standard
  premium
}

enum AvailabilityReason {
  blocked
  booked
}

enum BookingStatus {
  requested
  offered
  confirmed
  completed
  reviewed
  cancelled
  disputed
}

model VendorProfile {
  userId              String       @id @map("user_id") @db.Uuid
  types               VendorType[]
  headline            String
  about               String?
  yearsExperience     Int          @default(0) @map("years_experience")
  services            String[]
  genres              String[]
  languages           String[]
  areas               String[]
  equipment           String[]
  teamSize            Int          @default(1) @map("team_size")
  socialLinks         String[]     @map("social_links")
  level               VendorLevel  @default(new)
  /// Denormalised review stats (CLAUDE.md rule 18). rating_avg is stars × 100 to stay an integer.
  ratingAvg           Int          @default(0) @map("rating_avg")
  ratingCount         Int          @default(0) @map("rating_count")
  bookingsCount       Int          @default(0) @map("bookings_count")
  requestsCount       Int          @default(0) @map("requests_count")
  repliedCount        Int          @default(0) @map("replied_count")
  /// F20-AC1: auto-calculated average minutes to the vendor's first reply to a request.
  responseTimeMin     Int?         @map("response_time_min")
  /// Lowest active package price, for "Starting from" on cards (F20-AC4).
  startingPriceSantim Int?         @map("starting_price_santim")
  qualityScore        Float        @default(0) @map("quality_score")
  coverUrl            String?      @map("cover_url")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  albums       PortfolioAlbum[]
  credits      StageCredit[]
  packages     Package[]
  availability AvailabilityBlock[]
  requests     BookingRequest[]    @relation("BookingVendor")
  reviews      Review[]
  shortlisted  ShortlistItem[]

  @@index([qualityScore])
  @@map("vendor_profiles")
}

model PortfolioAlbum {
  id        String          @id @default(uuid()) @db.Uuid
  vendorId  String          @map("vendor_id") @db.Uuid
  title     String
  /// Optional ድንኳን event this work was done at; the event's organiser confirms it (F20-AC2).
  eventId   String?         @map("event_id") @db.Uuid
  gigStatus GigStatus       @default(none) @map("gig_status")
  coverUrl  String?         @map("cover_url")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  vendor    VendorProfile   @relation(fields: [vendorId], references: [userId], onDelete: Cascade)
  event     Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  items     PortfolioItem[]

  @@index([vendorId])
  @@index([eventId, gigStatus])
  @@map("portfolio_albums")
}

model PortfolioItem {
  id       String         @id @default(uuid()) @db.Uuid
  albumId  String         @map("album_id") @db.Uuid
  kind     MediaKind
  url      String
  thumbUrl String?        @map("thumb_url")
  width    Int
  height   Int
  caption  String?
  orderIdx Int            @default(0) @map("order_idx")
  album    PortfolioAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("portfolio_items")
}

model StageCredit {
  id       String        @id @default(uuid()) @db.Uuid
  vendorId String        @map("vendor_id") @db.Uuid
  name     String
  eventId  String?       @map("event_id") @db.Uuid
  date     DateTime?     @db.Date
  verified Boolean       @default(false)
  vendor   VendorProfile @relation(fields: [vendorId], references: [userId], onDelete: Cascade)
  event    Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@map("stage_credits")
}

model Package {
  id          String           @id @default(uuid()) @db.Uuid
  vendorId    String           @map("vendor_id") @db.Uuid
  tier        PackageTier
  name        String
  priceSantim Int              @map("price_santim")
  hours       Int
  includes    String[]
  active      Boolean          @default(true)
  vendor      VendorProfile    @relation(fields: [vendorId], references: [userId], onDelete: Cascade)
  addons      PackageAddon[]
  requests    BookingRequest[]

  @@unique([vendorId, tier])
  @@map("packages")
}

model PackageAddon {
  id          String  @id @default(uuid()) @db.Uuid
  packageId   String  @map("package_id") @db.Uuid
  name        String
  priceSantim Int     @map("price_santim")
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_addons")
}

model AvailabilityBlock {
  vendorId  String             @map("vendor_id") @db.Uuid
  date      DateTime           @db.Date
  reason    AvailabilityReason
  bookingId String?            @map("booking_id") @db.Uuid
  vendor    VendorProfile      @relation(fields: [vendorId], references: [userId], onDelete: Cascade)

  @@id([vendorId, date])
  @@index([date])
  @@map("availability_blocks")
}

model BookingRequest {
  id           String        @id @default(uuid()) @db.Uuid
  clientId     String        @map("client_id") @db.Uuid
  vendorId     String        @map("vendor_id") @db.Uuid
  packageId    String?       @map("package_id") @db.Uuid
  eventDate    DateTime      @map("event_date") @db.Date
  startTime    String        @map("start_time")
  venue        String
  eventType    String        @map("event_type")
  guests       Int
  budgetSantim Int?          @map("budget_santim")
  notes        String        @default("")
  status       BookingStatus @default(requested)
  campaignId   String?       @map("campaign_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  client       User          @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  vendor       VendorProfile @relation("BookingVendor", fields: [vendorId], references: [userId], onDelete: Cascade)
  package      Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@index([vendorId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("booking_requests")
}

model Conversation {
  id               String         @id @default(uuid()) @db.Uuid
  bookingRequestId String         @unique @map("booking_request_id") @db.Uuid
  clientId         String         @map("client_id") @db.Uuid
  vendorId         String         @map("vendor_id") @db.Uuid
  /// CLAUDE.md rule 16: contact details stay masked until a deposit is paid (Phase 2).
  contactUnlocked  Boolean        @default(false) @map("contact_unlocked")
  lastMessageAt    DateTime       @default(now()) @map("last_message_at") @db.Timestamptz
  clientReadAt     DateTime?      @map("client_read_at") @db.Timestamptz
  vendorReadAt     DateTime?      @map("vendor_read_at") @db.Timestamptz
  request          BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@index([clientId, lastMessageAt(sort: Desc)])
  @@index([vendorId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// `body` is the masked text people see. The original is kept server-side only so it can be
/// revealed once contact is unlocked, and for dispute evidence (F20-AC21).
model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String
  originalBody   String       @map("original_body")
  masked         Boolean      @default(false)
  /// F22-AC4: removed by a moderator; the body is no longer shown.
  removedAt      DateTime?    @map("removed_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Written only after a completed booking (Phase 2). The demo seeds some so profiles look real.
model Review {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String?       @unique @map("booking_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  vendorId      String        @map("vendor_id") @db.Uuid
  stars         Int
  punctuality   Int
  quality       Int
  value         Int
  communication Int
  body          String
  vendorReply   String?       @map("vendor_reply")
  /// F22-AC4: removed by a moderator; hidden and left out of the vendor's rating.
  removedAt     DateTime?     @map("removed_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  client        User          @relation("ReviewAuthor", fields: [clientId], references: [id], onDelete: Cascade)
  vendor        VendorProfile @relation(fields: [vendorId], references: [userId], onDelete: Cascade)

  @@index([vendorId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Shortlist {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  name       String
  shareToken String          @unique @map("share_token")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      ShortlistItem[]

  @@index([userId])
  @@map("shortlists")
}

model ShortlistItem {
  shortlistId String        @map("shortlist_id") @db.Uuid
  vendorId    String        @map("vendor_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  shortlist   Shortlist     @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  vendor      VendorProfile @relation(fields: [vendorId], references: [userId], onDelete: Cascade)

  @@id([shortlistId, vendorId])
  @@map("shortlist_items")
}

// ---------------------------------------------------------------------------
// PROMOTION (F21, Phase 1: ready-made packages, ad review, labelled placements, frequency caps,
// basic results and refunds of unspent budget). The self-serve CPM wizard is Phase 2.

enum PromoTarget {
  event
  post
  profile
  package
}

enum AdPlacementKey {
  feed
  reels
  events_featured
  home_weekend
  search_top
  push
}

enum CampaignStatus {
  pending_payment
  pending_review
  active
  paused
  ended
  rejected
  cancelled
}

/// Admin-configurable ready-made packages (F21-AC3).
model PromoPackage {
  key         String           @id
  nameEn      String           @map("name_en")
  nameAm      String           @map("name_am")
  priceSantim Int              @map("price_santim")
  days        Int
  /// Impressions promised across the run; null for fixed-slot packages.
  impressions Int?
  placements  AdPlacementKey[]
  targets     PromoTarget[]
  active      Boolean          @default(true)
  sortOrder   Int              @default(0) @map("sort_order")
  campaigns   Campaign[]

  @@map("promo_packages")
}

/// Per-placement pricing for the Phase 2 CPM engine (F21-AC4).
model AdPlacement {
  key            AdPlacementKey @id
  cpmSantim      Int            @map("cpm_santim")
  minDailySantim Int            @map("min_daily_santim")

  @@map("ad_placements")
}

model Campaign {
  id              String           @id @default(uuid()) @db.Uuid
  advertiserId    String           @map("advertiser_id") @db.Uuid
  packageKey      String           @map("package_key")
  targetType      PromoTarget      @map("target_type")
  targetId        String           @map("target_id") @db.Uuid
  placements      AdPlacementKey[]
  status          CampaignStatus   @default(pending_payment)
  budgetSantim    Int              @map("budget_santim")
  refundedSantim  Int              @default(0) @map("refunded_santim")
  impressionsGoal Int?             @map("impressions_goal")
  days            Int
  gateway         Gateway
  gatewayRef      String           @unique @map("gateway_ref")
  startsAt        DateTime?        @map("starts_at") @db.Timestamptz
  endsAt          DateTime?        @map("ends_at") @db.Timestamptz
  paidAt          DateTime?        @map("paid_at") @db.Timestamptz
  reviewedBy      String?          @map("reviewed_by") @db.Uuid
  reviewNote      String?          @map("review_note")
  /// Denormalised results (CLAUDE.md rule 18).
  impressions     Int              @default(0)
  reach           Int              @default(0)
  clicks          Int              @default(0)
  conversions     Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  advertiser      User             @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  package         PromoPackage     @relation(fields: [packageKey], references: [key])
  adImpressions   AdImpression[]
  adClicks        AdClick[]
  adConversions   AdConversion[]
  ledger          LedgerEntry[]

  @@index([status, endsAt])
  @@index([advertiserId, createdAt(sort: Desc)])
  @@map("campaigns")
}

/// One row per (campaign, viewer, day, placement) with a count, so the frequency cap (F21-AC9)
/// is a single indexed lookup. `viewerKey` is the user id, or an anonymous visitor cookie.
model AdImpression {
  campaignId String         @map("campaign_id") @db.Uuid
  viewerKey  String         @map("viewer_key")
  day        DateTime       @db.Date
  placement  AdPlacementKey
  count      Int            @default(1)
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, viewerKey, day, placement])
  @@index([viewerKey, day])
  @@map("ad_impressions")
}

model AdClick {
  id         String         @id @default(uuid()) @db.Uuid
  campaignId String         @map("campaign_id") @db.Uuid
  viewerKey  String         @map("viewer_key")
  placement  AdPlacementKey
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("ad_clicks")
}

model AdConversion {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  /// ticket_sale | booking_request | follow
  type       String
  refId      String   @map("ref_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, type, refId])
  @@map("ad_conversions")
}

enum OutboundStatus {
  pending
  sent
  failed
}

/// Outbox for messages sent outside the app (Telegram now; SMS and email later, F13). Written in
/// the same transaction as the change that causes it; a sender drains it. dedupeKey makes
/// retries and repeated cron runs send each message once.
model OutboundMessage {
  id        String         @id @default(uuid()) @db.Uuid
  channel   String
  userId    String         @map("user_id") @db.Uuid
  kind      String
  payload   Json
  dedupeKey String         @unique @map("dedupe_key")
  status    OutboundStatus @default(pending)
  attempts  Int            @default(0)
  lastError String?        @map("last_error")
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("outbound_messages")
}

/// One-time sign-in links the Telegram bot sends, so "Buy" opens checkout already logged in (F7-AC2).
model TelegramLoginToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_login_tokens")
}
